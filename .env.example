# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Dhaka
LOG_LEVEL=INFO

# Database: SQLite for local dev, Postgres in docker-compose
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://awd:awd@db:5432/awd

# Uploaded visit photos
MEDIA_ROOT=./media
PHOTO_MAX_BYTES=5242880
PHOTO_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Auth
JWT_LIFETIME_HOURS=12

# AWD rules
AWD_THRESHOLD_CM=-15
AWD_DAYS_BELOW_THRESHOLD=2
SENSOR_SILENT_DAYS=3
OVERFLOW_LEVEL_CM=10

# GraphiQL IDE at /graphql/
GRAPHIQL=true
